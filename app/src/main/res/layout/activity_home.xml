<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ===== Hero ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:clipChildren="true">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="-60dp"
                    android:background="@drawable/bg_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvGreeting"
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white_70" />

                            <TextView
                                android:id="@+id/tvName"
                                style="@style/Text.TitleM"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnBell"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_glass_btn"
                            android:contentDescription="@string/notifications"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardActiveTask"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_glass"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/home_active_task"
                                android:textColor="@color/white_70" />

                            <TextView
                                android:id="@+id/tvTaskPct"
                                style="@style/Text.Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_glass"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTaskTitle"
                            style="@style/Text.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/white" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressTask"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            app:indicatorColor="@color/brand_300"
                            app:trackColor="@color/white_20"
                            app:trackCornerRadius="8dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/tvTaskMeta"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/white_70" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNoTask"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_glass"
                        android:padding="16dp"
                        android:text="@string/home_no_task"
                        android:textColor="@color/white"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Konten ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    style="@style/Text.TitleM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_quick_menu" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/tileInventory"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tile_inventory"
                        android:clickable="true"
                        android:elevation="3dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconTile"
                            android:background="@drawable/bg_tile_glass"
                            android:src="@drawable/ic_scan"
                            app:tint="@color/white" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Text.TitleM"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tile_inventory"
                            android:textColor="@color/white" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tile_inventory_sub"
                            android:textColor="@color/white_70" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tileFind"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:contentPadding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    style="@style/IconTile"
                                    android:background="@drawable/bg_tile_blue"
                                    android:src="@drawable/ic_radar"
                                    app:tint="@color/brand_600" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView style="@style/Text.BodyMStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_find" />
                                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_find_sub" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tileEncode"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:contentPadding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    style="@style/IconTile"
                                    android:background="@drawable/bg_tile_sky"
                                    android:src="@drawable/ic_tag"
                                    app:tint="@color/brand_600" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView style="@style/Text.BodyMStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_encode" />
                                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_encode_sub" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:contentPadding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconTile"
                            android:background="@drawable/bg_tile_blue"
                            android:src="@drawable/ic_clipboard"
                            app:tint="@color/brand_600" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Text.BodyMStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_count" />
                            <TextView android:id="@+id/tvCountSub" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCountBadge"
                            style="@style/Text.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_info"
                            android:textColor="@color/status_info" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/boxReader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_status_online"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <View
                        android:id="@+id/dotReader"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_dot_ok" />

                    <TextView
                        android:id="@+id/tvReaderStatus"
                        style="@style/Text.BodyMStrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvReaderInfo"
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp" />
</FrameLayout>
