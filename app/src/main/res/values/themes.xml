<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Taggiot" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_700</item>
        <item name="colorSecondary">@color/brand_500</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/status_bad</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_700</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlHighlight">@color/ripple_hover</item>
        <item name="materialButtonStyle">@style/Widget.Taggiot.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Taggiot.Card</item>
        <item name="chipStyle">@style/Widget.Taggiot.Chip</item>
    </style>

    <!-- ===== Tombol ===== -->
    <style name="Widget.Taggiot.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/brand_500</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">22dp</item>
    </style>
    <!-- Aksi RFID: scan, tulis, ditemukan -->
    <style name="Widget.Taggiot.Button.Accent">
        <item name="backgroundTint">@color/brand_500</item>
    </style>
    <style name="Widget.Taggiot.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_700</item>
        <item name="strokeColor">@color/brand_100</item>
        <item name="rippleColor">@color/ripple_hover</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="iconTint">@color/brand_700</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">22dp</item>
    </style>
    <style name="Widget.Taggiot.Button.Soft">
        <item name="backgroundTint">@color/brand_50</item>
        <item name="android:textColor">@color/brand_700</item>
        <item name="iconTint">@color/brand_700</item>
    </style>
    <style name="Widget.Taggiot.Button.Small">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- ===== Kartu & chip ===== -->
    <style name="Widget.Taggiot.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">16dp</item>
    </style>
    <style name="Widget.Taggiot.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">99dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- ===== Tipografi ===== -->
    <style name="Text" />
    <style name="Text.Display">
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.TitleL">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.TitleM">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.BodyStrong">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>
    <style name="Text.BodyMStrong">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>
    <style name="Text.Mono">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>
    <style name="Text.Badge">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ===== Bottom nav ===== -->
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="NavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white_70</item>
    </style>
    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/white_70</item>
    </style>

    <!-- ===== Kotak statistik kaca di hero ===== -->
    <style name="GlassStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="GlassStat.Value" parent="Text.TitleM">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="GlassStat.Label" parent="Text.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white_70</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ===== Ubin ikon ===== -->
    <style name="IconTile">
        <item name="android:layout_width">@dimen/icon_tile</item>
        <item name="android:layout_height">@dimen/icon_tile</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- ===== Lembar aksi bawah ===== -->
    <style name="ActionSheet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:background">@drawable/bg_sheet</item>
        <item name="android:elevation">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- ===== Segmented control ===== -->
    <style name="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ===== Stepper ===== -->
    <style name="StepDot">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:background">@drawable/bg_step_todo</item>
    </style>
    <style name="StepLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="StepLine">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <!-- ===== Pengaturan ===== -->
    <style name="SettingsHeader" parent="Text.Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="SettingsCard" parent="Widget.Taggiot.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardElevation">1dp</item>
    </style>
</resources>
